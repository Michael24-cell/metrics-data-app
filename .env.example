# Athlete Intelligence Agent — environment (names only; never commit real values)
#
# Copy to .env.local (git-ignored). All variables are read SERVER-SIDE only;
# no key is ever sent to or readable by the browser.

# Anthropic API key for live mode. Absent → the agent runs in scripted mode
# (deterministic tool workflow over the local synthetic data). Never logged.
ANTHROPIC_API_KEY=

# Optional mode override: fixture | scripted | live
# fixture  = frozen test expectations (no DB reads)
# scripted = deterministic tool execution over current synthetic data (default without a key)
# live     = real model tool calling (requires ANTHROPIC_API_KEY; falls back to scripted on any failure)
AGENT_MODE=

# Optional model override for live mode (default: claude-opus-4-8)
AGENT_MODEL=
